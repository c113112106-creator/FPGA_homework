`timescale 1ns / 1ps

module top_pwmgo(
	input clk,rst,
	input change,
	input change_fast,
	output led_go/*,
	output hsync,vsync,
	output [3:0] vga_r,vga_g,vga_b*/
);
	wire [3:0] state_ref,state_fast;
	wire [7:0] frequency,duty;
	wire change_set,vga_clk,light_clk,change_fast_set;
	
	button U0(
		.click(change_set),
		.btn(change),
		.clk(clk),
		.rst(rst)
	);
	
	button U1(
		.click(change_fast_set),
		.btn(change_fast),
		.clk(clk),
		.rst(rst)
	);
	
	division U2(
		.rst(rst),
		.vga_clk(vga_clk),
		.clk(clk)
	);
	
	light_fast U3(
		.change_fast_set(change_fast_set),
		.light_clk(light_clk),
		.state_fast(state_fast),
		.clk(clk),
		.state_ref(state_ref),
		.rst(rst)
	);
	
	frequency_state U4(
		.clk(clk),
		.rst(rst),
		.state_ref(state_ref),
		.change_set(change_set),
		.frequency(frequency)
	);	
	
	pwm U6(
		.clk(clk),
		.rst(rst),
		.pwm_out(led_go),
		.duty(duty)
	);
	
	duty_countrol U7(
		.rst(rst),
		.duty(duty),
		.frequency(frequency),
		.light_clk(light_clk)
	);
	/*vga U8(
		.state_ref(state_ref),
		.state_fast(state_fast),
		.clk(vga_clk),
		.rst(rst),
		.hsync(hsync),
		.vsync(vsync),
		.vga_r(vga_r),
		.vga_g(vga_g),
		.vga_b(vga_b)
	);*/
endmodule

module light_fast(
	input clk,rst,
	input change_fast_set,
	input [3:0]state_ref,
	output reg [3:0]state_fast,
	output reg  light_clk
	);
	reg [27:0]countclk;
	parameter base=5'd14;///////////////////////////////////////////
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			light_clk<=0;
		end
		else begin
			case(state_ref)
				4'd0:begin
					light_clk=countclk[base+0+state_fast];
				end
				4'd1:begin
					light_clk=countclk[base+1+state_fast];;
				end
				4'd2:begin
					light_clk=countclk[base+2+state_fast];;
				end
				4'd3:begin
					light_clk=countclk[base+3+state_fast];;
				end
				4'd4:begin
					light_clk=countclk[base+4+state_fast];;
				end
				4'd5:begin
					light_clk=countclk[base+5+state_fast];;
				end
				default:begin
					light_clk=countclk[base+0+state_fast];
				end
			endcase
		end
	end
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			countclk<=28'd0;
		end
		else begin
			countclk <= countclk+28'd1;
		end
	end
	
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			state_fast<=4'd0;
		end
		else begin
			if(change_fast_set)begin
				state_fast<=state_fast+1;
				if(state_fast>=4'd5)begin
					state_fast<=4'd0;
				end
			end
			else begin
				state_fast<=state_fast;
			end
		end
	end
endmodule

module frequency_state(
	input clk,rst,
	input change_set,
	output reg [3:0]state_ref,
	output reg [7:0]frequency
	);
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			state_ref<=4'd0;
		end
		else begin
			if(change_set)begin
				state_ref<=state_ref+1;
				if(state_ref>=4'd5)begin
					state_ref<=4'd0;
				end
			end
			else begin
				state_ref<=state_ref;
			end
		end
	end
	always@(*)begin
		if(rst)begin
			frequency=8'd1;
		end
		else begin
			case(state_ref)
				4'd0:begin
					frequency=8'd1;
				end
				4'd1:begin
					frequency=8'd2;
				end
				4'd2:begin
					frequency=8'd4;
				end
				4'd3:begin
					frequency=8'd8;
				end
				4'd4:begin
					frequency=8'd16;
				end
				4'd5:begin
					frequency=8'd32;
				end
				default:begin
					frequency=8'd1;
				end
			endcase
		end
	end
endmodule

module duty_countrol(
    input rst,
	input light_clk,
	input [7:0] frequency,
    output reg [7:0] duty
	);
	parameter lighter =1'd0,
			  darker  =1'd1;
	reg state;
	always @(posedge light_clk or posedge rst) begin
		if (rst) begin
            duty<=8'd255;
			state<=darker;
        end
        else begin
			case(state)
				darker:begin
					if(duty >=frequency)begin
						duty<=duty-frequency;
					end
					else begin
						duty<=8'd0;
						state<=lighter;
					end
				end
				lighter:begin
					if(duty<=8'd255-frequency)begin
						duty<=duty+frequency;
					end
					else begin
						state<=darker;
						duty<=8'd255;
					end
				end
				default:begin
					state<=state;
					duty<=duty;
				end
			endcase
		end
	end
endmodule

module pwm(
    input clk,
    input rst,
    input [7:0] duty,
    output reg pwm_out
	);
    reg [7:0] counter;

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            counter <= 8'd0;
            pwm_out <= 1'b0;
        end
        else begin
            if (counter >= 8'd255)
                counter <= 8'd0;
            else
                counter <= counter + 1;

            if (counter < duty)
                pwm_out <= 1'b1;
            else
                pwm_out <= 1'b0;
        end
    end
endmodule

module division(
	input clk,rst,
	output vga_clk
	);
	reg [27:0]cnt;
	assign vga_clk=cnt[1];///////////////////
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			cnt<=28'd0;
		end
		else begin
			cnt <= cnt+28'd1;
		end
	end
endmodule

module button(
	input clk,rst,btn,
	output click
	);
	reg [23:0]decnt;
	reg sig_dly,sig;
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			sig<=0;
			decnt<=0;
		end
		else begin
			if(btn==1'b1)begin
				if(decnt<24'hFFFFFF)begin
					decnt<=decnt+24'd1;
					sig<=1'b0;
				end
				else begin
					decnt<=decnt;
					sig<=1'b1;
				end
			end
			else begin
				decnt<=24'd0;
				sig<=1'b0;
			end
		end
	end
	always@(posedge clk or posedge rst)begin
		if(rst)begin
			sig_dly<=1'b0;
		end
		else begin
			sig_dly<=sig;
		end
	end
	assign click=sig&~sig_dly;
endmodule


