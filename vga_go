`timescale 1ns / 1ps

module vga_go(
	input clk,
    input rst,
	input [1:0] which,
	input up_b, down_b, left_b, right_b,
    output hsync,
    output vsync,
    output [3:0] vga_r,
    output [3:0] vga_g,
    output [3:0] vga_b
);
	wire vga_clk,move_clk;
	
    wire [9:0] round_x;
    wire [9:0] circle_x;
    wire [9:0] triangle_x;

    wire [9:0] round_y;
    wire [9:0] circle_y;
    wire [9:0] triangle_y;

    division u0 (
        .clk(clk),
        .rst(rst),
		.move_clk(move_clk),
        .vga_clk(vga_clk)
    );

    location_controler u1 (
        .clk(move_clk),
        .rst(rst),
        .which(which),
        .up_b(up_b),
        .down_b(down_b),
        .left_b(left_b),
        .right_b(right_b),
        .round_x(round_x),
        .round_y(round_y),
        .circle_x(circle_x),
        .circle_y(circle_y),
        .triangle_x(triangle_x),
        .triangle_y(triangle_y)
    );

    vga u2 (
        .clk(vga_clk),
        .rst(rst),
        .round_x(round_x),
        .round_y(round_y),
        .circle_x(circle_x),
        .circle_y(circle_y),
        .triangle_x(triangle_x),
        .triangle_y(triangle_y),
        .hsync(hsync),
        .vsync(vsync),
        .vga_r(vga_r),
        .vga_g(vga_g),
        .vga_b(vga_b)
    );
endmodule



module location_controler(
    input clk,
    input rst,
    input [1:0] which,
    input up_b, down_b, left_b, right_b,

    output reg [9:0] round_x, circle_x, triangle_x,
    output reg [9:0] round_y, circle_y, triangle_y
);

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            round_x    <= 10'd320;
            round_y    <= 10'd120;

            circle_x   <= 10'd180;
            circle_y   <= 10'd340;

            triangle_x <= 10'd460;
            triangle_y <= 10'd340;
        end
        else begin
            case (which)
                // ??耦
                2'd1: begin
                    if (up_b && round_y > 10'd40)
                        round_y <= round_y - 10'd1;
                    else if (down_b && round_y < 10'd459)
                        round_y <= round_y + 10'd1;
                    else if (left_b && round_x > 10'd35)
                        round_x <= round_x - 10'd1;
                    else if (right_b && round_x < 10'd604)
                        round_x <= round_x + 10'd1;
                end
                // ????
                2'd2: begin
                    if (up_b && circle_y > 10'd40)
                        circle_y <= circle_y - 10'd1;
                    else if (down_b && circle_y < 10'd459)
                        circle_y <= circle_y + 10'd1;
                    else if (left_b && circle_x > 10'd35)
                        circle_x <= circle_x - 10'd1;
                    else if (right_b && circle_x < 10'd604)
                        circle_x <= circle_x + 10'd1;
                end
                // 甇?銝?耦
                2'd3: begin
                    if (up_b && triangle_y > 10'd40)
                        triangle_y <= triangle_y - 10'd1;
                    else if (down_b && triangle_y < 10'd459)
                        triangle_y <= triangle_y + 10'd1;
                    else if (left_b && triangle_x > 10'd35)
                        triangle_x <= triangle_x - 10'd1;
                    else if (right_b && triangle_x < 10'd604)
                        triangle_x <= triangle_x + 10'd1;
                end
                default: begin
                    round_x <= round_x;
					round_y <= round_y;	
					circle_x <= circle_x;
					circle_y <= circle_y;
					triangle_x <= triangle_x;
					triangle_y <= triangle_y;
                end
            endcase
        end
    end
endmodule

module vga (
    input clk,
    input rst,
    input [9:0] round_x,circle_x,triangle_x,
	input [9:0] round_y,circle_y,triangle_y,
    output hsync,
    output vsync,
    output reg [3:0] vga_r,
    output reg [3:0] vga_g,
    output reg [3:0] vga_b
);

    parameter   H_SYNC=96,
				H_SYNC_BACK_Porch=48,
				H_SYNC_ADDERSSABLE_VIDEO=630,
				H_SYNC_FRONT_PORCH=26,
				H_SYNC_PERIOD=H_SYNC+H_SYNC_ADDERSSABLE_VIDEO+H_SYNC_BACK_Porch+H_SYNC_FRONT_PORCH;
				
	parameter   V_SYNC=2,
				V_SYNC_BACK_Porch=33,
				V_SYNC_ADDERSSABLE_VIDEO_1=240,
				V_SYNC_ADDERSSABLE_VIDEO=480,
				V_SYNC_FRONT_PORCH=10,
				V_SYNC_PERIOD=V_SYNC+V_SYNC_ADDERSSABLE_VIDEO+V_SYNC_BACK_Porch+V_SYNC_FRONT_PORCH;
	
    reg [9:0] h_counter;
    reg [9:0] v_counter;
	reg [3:0] bit_sovle;
	wire [9:0] round_dx,round_dy;
	wire [9:0] circle_dx,circle_dy;
	wire valid_flag;
	wire signed [10:0] triangle_dx,triangle_dy;
	wire [10:0] abs_dx;
	wire [17:0] lhs, rhs;
	wire signed [11:0] y_from_top;
	wire in_triangle;
	
	wire [20:0] distance_round;
	wire [20:0] distance_circle;
	
	assign round_dx=(round_x>h_counter)?(round_x-h_counter):(h_counter-round_x);
	assign round_dy=(round_y>v_counter)?(round_y-v_counter):(v_counter-round_y);
	assign  distance_round=round_dx*round_dx+round_dy*round_dy;
	
	assign circle_dx=(circle_x>h_counter)?(circle_x-h_counter):(h_counter-circle_x);
	assign circle_dy=(circle_y>v_counter)?(circle_y-v_counter):(v_counter-circle_y);
	assign  distance_circle=circle_dy*circle_dy+circle_dx*circle_dx;

	assign triangle_dx=$signed({1'b0, h_counter})- $signed({1'b0, triangle_x});
	assign triangle_dy=$signed({1'b0, v_counter})- $signed({1'b0, triangle_y});
	assign abs_dx=(triangle_dx<0)?-triangle_dx:triangle_dx;
	assign y_from_top=triangle_dy+12'sd40;
	assign lhs=abs_dx*8'd60;
	assign rhs=$unsigned(y_from_top)*7'd35;
	assign in_triangle =(triangle_dy >= -11'sd40) &&(triangle_dy <=  11'sd20) &&(lhs <= rhs);
	
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            h_counter <= 10'd0;
        end
        else begin
			if (h_counter == H_SYNC_PERIOD - 1) begin
					h_counter <= 10'd0;
			end
			else begin
				h_counter <= h_counter + 10'd1;
			end
        end
    end

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            v_counter <= 10'd0;
        end
        else begin
			if ((v_counter == V_SYNC_PERIOD - 1) &&
				(h_counter == H_SYNC_PERIOD - 1)) begin
				v_counter <= 10'd0;
			end
			else begin
				if (h_counter == H_SYNC_PERIOD - 1) begin
					v_counter <= v_counter + 10'd1;
				end
				else begin
					v_counter <= v_counter;
				end
			end
        end
    end

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            vga_r <= 4'h0;
            vga_g <= 4'h0;
            vga_b <= 4'h0;
        end
        else begin
			if (valid_flag) begin
				if(distance_round<=21'd400)begin
					//???
					vga_r <= 4'hf;
					vga_g <= 4'h0;
					vga_b <= 4'h0;
				end
				else begin
					if((distance_circle<=21'd400) && (distance_circle>=21'd289))begin
						//????
						vga_r <= 4'h0;
						vga_g <= 4'hf;
						vga_b <= 4'h0;
					end
					else begin
						if(in_triangle)begin
							//銝??
							vga_r <= 4'h0;
							vga_g <= 4'h0;
							vga_b <= 4'hf;
						end
						else begin
							//摨
							vga_r <= 4'hf;
							vga_g <= 4'hF;
							vga_b <= 4'hf;
						end
					end
				end
			end
			else begin
				vga_r <= 4'h0;
				vga_g <= 4'h0;
				vga_b <= 4'h0;
			end
        end
    end

    assign hsync = (h_counter <= H_SYNC - 1'b1) ? 1'b1 : 1'b0;

    assign vsync = (v_counter <= V_SYNC - 1'b1) ? 1'b1 : 1'b0;

    assign valid_flag =
        (h_counter >= (H_SYNC + H_SYNC_BACK_Porch)) &&
        (h_counter <= (H_SYNC + H_SYNC_BACK_Porch + H_SYNC_ADDERSSABLE_VIDEO)) &&
        (v_counter >= (V_SYNC + V_SYNC_BACK_Porch)) &&
        (v_counter <= (V_SYNC + V_SYNC_BACK_Porch + V_SYNC_ADDERSSABLE_VIDEO-1));
endmodule


module division(
    input clk, rst,
    output vga_clk,
	output move_clk
);
    reg [27:0] cnt;
	assign move_clk = cnt[19];//////////////////////////////////
    assign vga_clk = cnt[1];//////////////////////////////////
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            cnt <= 28'd0;
        end
        else begin
			cnt <= cnt + 28'd1;
        end
    end
endmodule
